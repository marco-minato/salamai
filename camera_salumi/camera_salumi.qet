            <input x="740" y="170" rotation="0" text="&lt;b&gt;-A1&lt;/b&gt; Waveshare ESP32-S3-Relay-6CH&lt;br&gt;relè CH1, CH2, CH3&lt;br&gt;morsetti COM – NA (NC non usato)" font="Sans Serif,7,-1,5,50,0,0,0,0,0" />
            <input x="700" y="322" rotation="0" text="&lt;b&gt;-E1 Stufa a 3 lampade IR, 1200 W&lt;/b&gt; (in camera)" font="Sans Serif,8,-1,5,50,0,0,0,0,0" />
            <input x="700" y="262" rotation="0" text="&lt;b&gt;-W1&lt;/b&gt; cavo 5G1,5 quadro → stufa&lt;br&gt;(L1, L2, L3, N, PE)" font="Sans Serif,7,-1,5,50,0,0,0,0,0" />
            <input x="1034" y="425" rotation="0" text="S4 e M1 (rotazione):&lt;br&gt;&lt;b&gt;non collegati&lt;/b&gt;" font="Sans Serif,7,-1,5,50,0,0,0,0,0" />
            <input x="990" y="690" rotation="0" text="carcassa&lt;br&gt;(giallo-verde interno)" font="Sans Serif,7,-1,5,50,0,0,0,0,0" />
            <input x="900" y="625" rotation="0" text="antiribaltamento:&lt;br&gt;chiuso a stufa in piedi" font="Sans Serif,7,-1,5,50,0,0,0,0,0" />
            <input x="330" y="565" rotation="0" text="ritorni lampade uniti&lt;br&gt;(filo blu interno)" font="Sans Serif,7,-1,5,50,0,0,0,0,0" />
            <input x="1125" y="120" rotation="0" text="&lt;b&gt;Note&lt;/b&gt;&lt;br&gt;• Cavallotto originale tra S1–S2–S3–S4 &lt;b&gt;rimosso&lt;/b&gt;:&lt;br&gt;&amp;nbsp;&amp;nbsp;le tre lampade sono indipendenti.&lt;br&gt;• S1, S2, S3 restano su «acceso»: servono solo&lt;br&gt;&amp;nbsp;&amp;nbsp;come esclusione manuale.&lt;br&gt;• Antiribaltamento -S5: se in origine era sulla fase,&lt;br&gt;&amp;nbsp;&amp;nbsp;viene &lt;b&gt;spostato sul neutro comune&lt;/b&gt; delle lampade.&lt;br&gt;• Giunzione -W1 ↔ fili interni nella parte bassa&lt;br&gt;&amp;nbsp;&amp;nbsp;della stufa; da lì agli interruttori filo silicone&lt;br&gt;&amp;nbsp;&amp;nbsp;18 AWG in guaina di vetro (zona calda).&lt;br&gt;• Logica (ESPHome): lampade comandate una per&lt;br&gt;&amp;nbsp;&amp;nbsp;una; la lampada «di base» ruota.&lt;br&gt;• -B3 (folio 2) toglie la fase a tutte le lampade." font="Sans Serif,8,-1,5,50,0,0,0,0,0" />
        </inputs>
