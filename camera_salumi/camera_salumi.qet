    <diagram title="Distinta componenti" author="" date="20261013" filename="camera_salumi" folio="%id/%total" order="8" cols="24" rows="18" colsize="60" rowsize="80" height="1460" displaycols="true" displayrows="true" displayAt="bottom" version="0.90" indexrev="B" plant="" locmach="" auto_page_num="" freezeNewElement="false" freezeNewConductor="false" titleblocktemplate="camera_salumi" titleblocktemplateCollection="embedded">
        <properties>
            <property name="progetto" show="1">Camera salumi — controllo ESP32</property>
            <property name="revisione" show="1">B</property>
            <property name="data" show="1">13/10/2026</property>
        </properties>
        <defaultconductor type="multi" num="" formula="" displaytext="1" numsize="7" condsize="1" text_color="#000000" conductor_color="" color2="#000000" bicolor="false" dash-size="1" cable="" bus="" function="" tension_protocol="" conductor_section="" onetextperfolio="0" horizrotatetext="0" vertirotatetext="270" horizontal-alignment="AlignBottom" vertical-alignment="AlignRight" />
        <elements />
        <conductors />
        <inputs>
            <input x="50" y="20" rotation="0" text="&lt;b&gt;Distinta componenti&lt;/b&gt; — generata da QElectroTech dalle informazioni degli elementi" font="Sans Serif,9,-1,5,50,0,0,0,0,0" />
            <input x="50" y="800" rotation="0" text="&lt;b&gt;Cavi, morsetti e meccanica&lt;/b&gt; (non rappresentati come elementi)&lt;table border=&quot;1&quot; cellspacing=&quot;0&quot; cellpadding=&quot;3&quot;&gt;&lt;tr&gt;&lt;th&gt;Sigla&lt;/th&gt;&lt;th&gt;Descrizione&lt;/th&gt;&lt;th&gt;Note&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;-W1&lt;/td&gt;&lt;td&gt;Cavo 5G1,5 quadro → stufa&lt;/td&gt;&lt;td&gt;L1 marrone, L2 nero, L3 grigio, N blu, PE giallo-verde&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;-W2&lt;/td&gt;&lt;td&gt;Cavo 2×1,5 (o 3G1,5) quadro → termostato -B3&lt;/td&gt;&lt;td&gt;Rev. A: fase lampade. Rev. B: 12 V della bobina di -Q7 (cavo 2×0,75)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;-W3&lt;/td&gt;&lt;td&gt;Cavo 4 poli quadro → sonda -B1&lt;/td&gt;&lt;td&gt;+12 V, GND, A, B (A e B sullo stesso doppino)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;-W4&lt;/td&gt;&lt;td&gt;Cavo di rete (doppini) quadro → -A4&lt;/td&gt;&lt;td&gt;3,3 V, GND, DOUT, SCK (DOUT e SCK accoppiati a GND)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;-X1&lt;/td&gt;&lt;td&gt;Scatola da esterno con 3 prese Schuko&lt;/td&gt;&lt;td&gt;XS1, XS2, XS3 — accanto al quadro&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;-X2…&lt;/td&gt;&lt;td&gt;Morsetti Wago 221 / morsettiere&lt;/td&gt;&lt;td&gt;Distribuzione N, PE e bassa tensione (nodi dello schema)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;—&lt;/td&gt;&lt;td&gt;Filo silicone 18 AWG (B07TT68455)&lt;/td&gt;&lt;td&gt;Collegamenti interni alla stufa, in guaina di vetro&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;—&lt;/td&gt;&lt;td&gt;Quadro IP65 24 moduli 2 file (B0DPXCLZPR)&lt;/td&gt;&lt;td&gt;Clip DIN per PCB (B0FCM3N3P9), pressacavi M20 (B0GYRDCC9Z)&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" font="Sans Serif,7,-1,5,50,0,0,0,0,0" />
            <input x="50" y="1040" rotation="0" text="&lt;b&gt;Modifiche ai materiali — rev. B&lt;/b&gt; (proposta, vedi folii 7 e 9)&lt;table border=&quot;1&quot; cellspacing=&quot;0&quot; cellpadding=&quot;3&quot;&gt;&lt;tr&gt;&lt;th&gt;&lt;/th&gt;&lt;th&gt;Sigla&lt;/th&gt;&lt;th&gt;Materiale&lt;/th&gt;&lt;th&gt;Motivo / note&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;+&lt;/td&gt;&lt;td&gt;-Q0&lt;/td&gt;&lt;td&gt;Sezionatore modulare 2P, 25 A o più&lt;/td&gt;&lt;td&gt;Sezionamento locale: l'interruttore a monte è nel quadro generale&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;+&lt;/td&gt;&lt;td&gt;-F1&lt;/td&gt;&lt;td&gt;Interruttore magnetotermico 1P+N C10&lt;/td&gt;&lt;td&gt;Ramo stufa (5,2 A); protegge anche il cavo -W1&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;+&lt;/td&gt;&lt;td&gt;-F2&lt;/td&gt;&lt;td&gt;Interruttore magnetotermico 1P+N C6&lt;/td&gt;&lt;td&gt;Ramo prese: umidificatori ed estrattore&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;+&lt;/td&gt;&lt;td&gt;-F3&lt;/td&gt;&lt;td&gt;Interruttore magnetotermico 1P+N C6&lt;/td&gt;&lt;td&gt;Ausiliari: -T1 e misura di tensione di -A3&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;+&lt;/td&gt;&lt;td&gt;-Q1…-Q7&lt;/td&gt;&lt;td&gt;7 contattori modulari 2 NA 25 A, bobina 12 V AC/DC, contatti AgSnO2 (es. Finder 22.32.0.012.4340)&lt;/td&gt;&lt;td&gt;Isolamento rinforzato bobina/contatti, 2000 W di lampade alogene; -Q7 senza forzatura manuale&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;↔&lt;/td&gt;&lt;td&gt;-T1&lt;/td&gt;&lt;td&gt;Mean Well HDR-60-12 (54 W, 3 moduli) al posto di HDR-30-12 (24 W)&lt;/td&gt;&lt;td&gt;7 bobine da 2,2 W + scheda + ventole ≈ 25 W&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;↔&lt;/td&gt;&lt;td&gt;—&lt;/td&gt;&lt;td&gt;Cassetta IP65 ~400 × 600 × 200 con piastra di fondo al posto del centralino da 24 moduli&lt;/td&gt;&lt;td&gt;4 guide DIN, canalina asolata 25 × 40 (~2,5 m)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;↔&lt;/td&gt;&lt;td&gt;-X0, -X2, -XPE, -X3&lt;/td&gt;&lt;td&gt;Morsetti su guida (3 + 10 + terra da 2,5 mm²; 14 piccoli), fermi, setto separatore, ponticelli&lt;/td&gt;&lt;td&gt;Al posto dei Wago 221 usati come nodi&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;↔&lt;/td&gt;&lt;td&gt;-W2&lt;/td&gt;&lt;td&gt;Cavo 2 × 0,75 al posto di 2 × 1,5&lt;/td&gt;&lt;td&gt;Il termostato lavora a 12 V sulla bobina di -Q7&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;+&lt;/td&gt;&lt;td&gt;—&lt;/td&gt;&lt;td&gt;Filo H07V-K 1,5 mm² (230 V) e H05V-K 0,75 mm² (comandi), puntalini, pressacavi M20 e M12&lt;/td&gt;&lt;td&gt;Colori: fase marrone/nero/grigio, neutro blu, terra giallo-verde&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;?&lt;/td&gt;&lt;td&gt;—&lt;/td&gt;&lt;td&gt;Isolatore RS485 per -A3&lt;/td&gt;&lt;td&gt;Solo se la prova di isolamento del PZEM non è soddisfacente&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" font="Sans Serif,7,-1,5,50,0,0,0,0,0" />
        </inputs>
