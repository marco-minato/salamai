    <diagram title="Copertina e legenda" author="" date="20261013" filename="camera_salumi" folio="%id/%total" order="1" cols="24" rows="12" colsize="60" rowsize="80" height="980" displaycols="true" displayrows="true" displayAt="bottom" version="0.90" indexrev="B" plant="" locmach="" auto_page_num="" freezeNewElement="false" freezeNewConductor="false" titleblocktemplate="camera_salumi" titleblocktemplateCollection="embedded">
        <properties>
            <property name="progetto" show="1">Camera salumi — controllo ESP32</property>
            <property name="revisione" show="1">B</property>
            <property name="data" show="1">13/10/2026</property>
        </properties>
        <defaultconductor type="multi" num="" formula="" displaytext="1" numsize="7" condsize="1" text_color="#000000" conductor_color="" color2="#000000" bicolor="false" dash-size="1" cable="" bus="" function="" tension_protocol="" conductor_section="" onetextperfolio="0" horizrotatetext="0" vertirotatetext="270" horizontal-alignment="AlignBottom" vertical-alignment="AlignRight" />
        <elements />
        <conductors />
        <inputs>
            <input x="60" y="30" rotation="0" text="&lt;span style=&quot;font-size:26pt&quot;&gt;&lt;b&gt;Camera salumi — controllo ESP32&lt;/b&gt;&lt;/span&gt;" font="Sans Serif,9,-1,5,50,0,0,0,0,0" />
            <input x="60" y="90" rotation="0" text="Camera di asciugatura e stagionatura salumi: ciclo di circa 15 giorni a temperatura e umidità&lt;br&gt;controllate (da 20 °C / 72 % UR a 12 °C / 80 % UR). Quadro di comando in cantina, fuori dalla camera;&lt;br&gt;in camera: stufa a 3 lampade IR, 2 umidificatori, ventole, estrattore, sonda, bilancia, termostato di sicurezza.&lt;br&gt;Controllo: scheda Waveshare ESP32-S3-Relay-6CH con firmware ESPHome, integrata in Home Assistant.&lt;br&gt;&lt;b&gt;Revisione B&lt;/b&gt; — 13/10/2026 — autore: (da compilare)" font="Sans Serif,10,-1,5,50,0,0,0,0,0" />
            <input x="60" y="230" rotation="0" text="&lt;b&gt;Elenco folii&lt;/b&gt;&lt;table border=&quot;1&quot; cellspacing=&quot;0&quot; cellpadding=&quot;3&quot;&gt;&lt;tr&gt;&lt;th&gt;Folio&lt;/th&gt;&lt;th&gt;Contenuto&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;1&lt;/td&gt;&lt;td&gt;Copertina e legenda&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;2&lt;/td&gt;&lt;td&gt;Alimentazione 230 V&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;3&lt;/td&gt;&lt;td&gt;Stufa (3 lampade IR)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;4&lt;/td&gt;&lt;td&gt;Prese di servizio&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;5&lt;/td&gt;&lt;td&gt;Bassa tensione 12 V / 5 V&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;6&lt;/td&gt;&lt;td&gt;Bus RS485 e sensori&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;7&lt;/td&gt;&lt;td&gt;Disposizione su piastra — rev B&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;8&lt;/td&gt;&lt;td&gt;Distinta componenti&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;9&lt;/td&gt;&lt;td&gt;Cablaggio del quadro (vista d'insieme) — rev B&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" font="Sans Serif,9,-1,5,50,0,0,0,0,0" />
            <input x="60" y="520" rotation="0" text="&lt;b&gt;Colori dei conduttori (convenzione del disegno)&lt;/b&gt;&lt;table border=&quot;1&quot; cellspacing=&quot;0&quot; cellpadding=&quot;3&quot;&gt;&lt;tr&gt;&lt;th&gt;Conduttore&lt;/th&gt;&lt;th&gt;Colore&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;L — fase 230 V (anche L-lampade, L1 di W1)&lt;/td&gt;&lt;td&gt;&lt;span style=&quot;color:#8b4513&quot;&gt;■&lt;/span&gt; marrone&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;L2 di W1 (lampada 2)&lt;/td&gt;&lt;td&gt;&lt;span style=&quot;color:#000000&quot;&gt;■&lt;/span&gt; nero&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;L3 di W1 (lampada 3)&lt;/td&gt;&lt;td&gt;&lt;span style=&quot;color:#808080&quot;&gt;■&lt;/span&gt; grigio&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;N — neutro&lt;/td&gt;&lt;td&gt;&lt;span style=&quot;color:#0000ff&quot;&gt;■&lt;/span&gt; blu&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;PE — protezione&lt;/td&gt;&lt;td&gt;&lt;span style=&quot;color:#00aa00&quot;&gt;■&lt;/span&gt;&lt;span style=&quot;color:#d8d800&quot;&gt;■&lt;/span&gt; giallo-verde&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;+12 V DC&lt;/td&gt;&lt;td&gt;&lt;span style=&quot;color:#ff0000&quot;&gt;■&lt;/span&gt; rosso&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;+5 V DC&lt;/td&gt;&lt;td&gt;&lt;span style=&quot;color:#ff8800&quot;&gt;■&lt;/span&gt; arancione&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;0 V / GND&lt;/td&gt;&lt;td&gt;&lt;span style=&quot;color:#000000&quot;&gt;■&lt;/span&gt; nero&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Segnali logici (PWM, HX711, I²C)&lt;/td&gt;&lt;td&gt;&lt;span style=&quot;color:#aa00aa&quot;&gt;■&lt;/span&gt; viola&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;RS485 A&lt;/td&gt;&lt;td&gt;&lt;span style=&quot;color:#008080&quot;&gt;■&lt;/span&gt; verde acqua&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;RS485 B&lt;/td&gt;&lt;td&gt;&lt;span style=&quot;color:#6b8e23&quot;&gt;■&lt;/span&gt; verde oliva&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Comando bobine 12 V (folio 9)&lt;/td&gt;&lt;td&gt;&lt;span style=&quot;color:#ff66cc&quot;&gt;■&lt;/span&gt; rosa&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;Tratteggiato&lt;/td&gt;&lt;td&gt;opzionale / non collegato&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" font="Sans Serif,9,-1,5,50,0,0,0,0,0" />
            <input x="520" y="230" rotation="0" text="&lt;b&gt;Legenda sigle (IEC 81346)&lt;/b&gt;&lt;table border=&quot;1&quot; cellspacing=&quot;0&quot; cellpadding=&quot;3&quot;&gt;&lt;tr&gt;&lt;th&gt;Sigla&lt;/th&gt;&lt;th&gt;Significato&lt;/th&gt;&lt;th&gt;In questo progetto&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;-A&lt;/td&gt;&lt;td&gt;Assieme / scheda elettronica&lt;/td&gt;&lt;td&gt;A1 scheda relè, A2 MOSFET, A3 PZEM-016, A4 HX711, A5 RTC&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;-B&lt;/td&gt;&lt;td&gt;Sensore / trasduttore&lt;/td&gt;&lt;td&gt;B1 sonda T/UR, B2 cella di carico, B3 termostato di sicurezza&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;-E&lt;/td&gt;&lt;td&gt;Riscaldamento / illuminazione&lt;/td&gt;&lt;td&gt;E1 stufa, E1.1–E1.3 lampade IR&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;-F&lt;/td&gt;&lt;td&gt;Protezione&lt;/td&gt;&lt;td&gt;F1 stufa, F2 prese, F3 ausiliari (rev. B)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;-K&lt;/td&gt;&lt;td&gt;Relè (a bordo di -A1)&lt;/td&gt;&lt;td&gt;K1–K3 lampade, K4–K5 umidificatori, K6 estrattore&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;-Q&lt;/td&gt;&lt;td&gt;Sezionatore / contattore&lt;/td&gt;&lt;td&gt;Q0 sezionatore, Q1–Q6 contattori dei carichi, Q7 sicurezza lampade (rev. B)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;-M&lt;/td&gt;&lt;td&gt;Motore / utilizzatore&lt;/td&gt;&lt;td&gt;M1 rotazione (scollegato), M2–M3 umidificatori, M4 estrattore, M5–M6 ventole&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;-S&lt;/td&gt;&lt;td&gt;Comando manuale / contatto&lt;/td&gt;&lt;td&gt;S1–S4 interruttori stufa, S5 antiribaltamento&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;-T&lt;/td&gt;&lt;td&gt;Alimentatore / convertitore&lt;/td&gt;&lt;td&gt;T1 230 VAC → 12 V DC, T2 12 → 5 V DC&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;-W&lt;/td&gt;&lt;td&gt;Cavo&lt;/td&gt;&lt;td&gt;W1 stufa, W2 termostato, W3 sonda, W4 HX711&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;-X&lt;/td&gt;&lt;td&gt;Morsetti / prese&lt;/td&gt;&lt;td&gt;X0 ingresso linea, X1 scatola prese (XS1–XS3), X2 uscite 230 V, X3 morsetti SELV, XPE terra&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" font="Sans Serif,9,-1,5,50,0,0,0,0,0" />
            <input x="520" y="560" rotation="0" text="&lt;b&gt;Convenzioni&lt;/b&gt;&lt;br&gt;• I relè K1–K6 sono a bordo della scheda -A1: sui folii 3 e 4 compare il solo contatto COM–NA.&lt;br&gt;• La scheda -A1 è rappresentata a blocchi funzionali su più folii (relè, alimentazione, RS485, connettore H1).&lt;br&gt;• Le frecce ai bordi sono rimandi tra folii: accanto è indicato folio e posizione di arrivo/partenza.&lt;br&gt;• I riquadri tratteggiati indicano dove si trova fisicamente l'apparecchio (in camera, scatola prese…).&lt;br&gt;• GPIO e pin dei connettori H1 / H2 della scheda -A1: assegnazione e piedinatura completa sul folio 6.&lt;br&gt;• I nodi (punti neri) sono ponticelli sulle morsettiere (-X0, -X2, -XPE, -X3) o derivazioni a pettine.&lt;br&gt;• &lt;b&gt;Rev. B&lt;/b&gt;: i folii 7, 8 e 9 riportano la proposta con sezionatore -Q0, protezioni -F1…-F3 e contattori -Q1…-Q7;&lt;br&gt;&amp;nbsp;&amp;nbsp;i folii 2–5 sono ancora alla rev. A e portano un avviso in basso." font="Sans Serif,9,-1,5,50,0,0,0,0,0" />
        </inputs>
    </diagram>
