        <inputs>
            <input x="50" y="20" rotation="0" text="&lt;b&gt;Distinta componenti&lt;/b&gt; — generata da QElectroTech dalle informazioni degli elementi" font="Sans Serif,9,-1,5,50,0,0,0,0,0" />
            <input x="50" y="800" rotation="0" text="&lt;b&gt;Cavi, morsetti e meccanica&lt;/b&gt; (non rappresentati come elementi)&lt;table border=&quot;1&quot; cellspacing=&quot;0&quot; cellpadding=&quot;3&quot;&gt;&lt;tr&gt;&lt;th&gt;Sigla&lt;/th&gt;&lt;th&gt;Descrizione&lt;/th&gt;&lt;th&gt;Note&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;-W1&lt;/td&gt;&lt;td&gt;Cavo 5G1,5 quadro → stufa&lt;/td&gt;&lt;td&gt;L1 marrone, L2 nero, L3 grigio, N blu, PE giallo-verde&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;-W2&lt;/td&gt;&lt;td&gt;Cavo 2×1,5 (o 3G1,5) quadro → termostato -B3&lt;/td&gt;&lt;td&gt;Andata e ritorno della fase lampade&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;-W3&lt;/td&gt;&lt;td&gt;Cavo 4 poli quadro → sonda -B1&lt;/td&gt;&lt;td&gt;+12 V, GND, A, B&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;-W4&lt;/td&gt;&lt;td&gt;Cavo di rete (doppini) quadro → -A4&lt;/td&gt;&lt;td&gt;3,3 V, GND, DOUT, SCK (DOUT e SCK accoppiati a GND)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;-X1&lt;/td&gt;&lt;td&gt;Scatola da esterno con 3 prese Schuko&lt;/td&gt;&lt;td&gt;XS1, XS2, XS3 — accanto al quadro&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;-X2…&lt;/td&gt;&lt;td&gt;Morsetti Wago 221 / morsettiere&lt;/td&gt;&lt;td&gt;Distribuzione N, PE e bassa tensione (nodi dello schema)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;—&lt;/td&gt;&lt;td&gt;Filo silicone 18 AWG (B07TT68455)&lt;/td&gt;&lt;td&gt;Collegamenti interni alla stufa, in guaina di vetro&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;—&lt;/td&gt;&lt;td&gt;Quadro IP65 24 moduli 2 file (B0DPXCLZPR)&lt;/td&gt;&lt;td&gt;Clip DIN per PCB (B0FCM3N3P9), pressacavi M20 (B0GYRDCC9Z)&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" font="Sans Serif,7,-1,5,50,0,0,0,0,0" />
        </inputs>
