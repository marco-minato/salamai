    <diagram title="Fronte / disposizione quadro" author="" date="20261013" filename="camera_salumi" folio="%id/%total" order="7" cols="24" rows="11" colsize="60" rowsize="80" height="900" displaycols="true" displayrows="true" displayAt="bottom" version="0.90" indexrev="A" plant="" locmach="" auto_page_num="" freezeNewElement="false" freezeNewConductor="false" titleblocktemplate="camera_salumi" titleblocktemplateCollection="embedded">
        <properties>
            <property name="progetto" show="1">Camera salumi — controllo ESP32</property>
            <property name="revisione" show="1">A</property>
            <property name="data" show="1">13/10/2026</property>
        </properties>
        <defaultconductor type="multi" num="" formula="" displaytext="1" numsize="7" condsize="1" text_color="#000000" conductor_color="" color2="#000000" bicolor="false" dash-size="1" cable="" bus="" function="" tension_protocol="" conductor_section="" onetextperfolio="0" horizrotatetext="0" vertirotatetext="270" horizontal-alignment="AlignBottom" vertical-alignment="AlignRight" />
        <elements />
        <conductors />
        <inputs>
            <input x="100" y="30" rotation="0" text="&lt;b&gt;Quadro IP65 — 24 moduli su 2 file&lt;/b&gt; (1 modulo = 17,5 mm; vista frontale, non in scala esatta)" font="Sans Serif,9,-1,5,50,0,0,0,0,0" />
            <input x="140" y="82" rotation="0" text="Fila superiore — 230 V" font="Sans Serif,8,-1,5,50,0,0,0,0,0" />
            <input x="140" y="412" rotation="0" text="Fila inferiore — bassa tensione" font="Sans Serif,8,-1,5,50,0,0,0,0,0" />
            <input x="144" y="200" rotation="0" text="&lt;b&gt;-X0&lt;/b&gt;&lt;br&gt;L N PE" font="Sans Serif,7,-1,5,50,0,0,0,0,0" />
            <input x="204" y="200" rotation="0" text="&lt;b&gt;-T1&lt;/b&gt;&lt;br&gt;Mean Well&lt;br&gt;HDR-30-12&lt;br&gt;2 mod" font="Sans Serif,7,-1,5,50,0,0,0,0,0" />
            <input x="324" y="200" rotation="0" text="&lt;b&gt;-A3&lt;/b&gt; PZEM-016&lt;br&gt;su clip DIN&lt;br&gt;~4 mod" font="Sans Serif,7,-1,5,50,0,0,0,0,0" />
            <input x="564" y="200" rotation="0" text="&lt;b&gt;-X2…&lt;/b&gt;&lt;br&gt;morsetti&lt;br&gt;N / PE" font="Sans Serif,7,-1,5,50,0,0,0,0,0" />
            <input x="684" y="200" rotation="0" text="spazio libero&lt;br&gt;3 mod" font="Sans Serif,7,-1,5,50,0,0,0,0,0" />
            <input x="144" y="530" rotation="0" text="&lt;b&gt;-A1&lt;/b&gt; Waveshare ESP32-S3-Relay-6CH&lt;br&gt;145 × 90 mm (~9 mod)&lt;br&gt;frontale alto 90 mm: mostrina rimossa" font="Sans Serif,7,-1,5,50,0,0,0,0,0" />
            <input x="641" y="530" rotation="0" text="&lt;b&gt;-A2&lt;/b&gt; MOSFET&lt;br&gt;&lt;b&gt;-T2&lt;/b&gt; DC-DC&lt;br&gt;su clip DIN&lt;br&gt;~3 mod" font="Sans Serif,7,-1,5,50,0,0,0,0,0" />
            <input x="821" y="530" rotation="0" text="&lt;b&gt;X&lt;/b&gt;" font="Sans Serif,7,-1,5,50,0,0,0,0,0" />
            <input x="140" y="716" rotation="0" text="&lt;b&gt;Morsetti bassa tensione&lt;/b&gt; (12 V / 5 V / RS485 / cavo HX711):&lt;br&gt;con -A1 (~9 mod) e clip -A2/-T2 (~3 mod) la fila è piena: restano ~12 mm (riquadro X).&lt;br&gt;Da verificare: morsetti BT su un secondo livello o nello spazio libero della fila superiore, separati dal 230 V." font="Sans Serif,7,-1,5,50,0,0,0,0,0" />
            <input x="160" y="800" rotation="0" text="linea" font="Sans Serif,7,-1,5,50,0,0,0,0,0" />
            <input x="230" y="800" rotation="0" text="-W1" font="Sans Serif,7,-1,5,50,0,0,0,0,0" />
            <input x="300" y="800" rotation="0" text="-W2" font="Sans Serif,7,-1,5,50,0,0,0,0,0" />
            <input x="370" y="800" rotation="0" text="-X1 prese" font="Sans Serif,7,-1,5,50,0,0,0,0,0" />
            <input x="600" y="800" rotation="0" text="-W3" font="Sans Serif,7,-1,5,50,0,0,0,0,0" />
            <input x="670" y="800" rotation="0" text="-W4" font="Sans Serif,7,-1,5,50,0,0,0,0,0" />
            <input x="740" y="800" rotation="0" text="ventole" font="Sans Serif,7,-1,5,50,0,0,0,0,0" />
            <input x="240" y="826" rotation="0" text="pressacavi 230 V" font="Sans Serif,7,-1,5,50,0,0,0,0,0" />
            <input x="630" y="826" rotation="0" text="pressacavi bassa tensione" font="Sans Serif,7,-1,5,50,0,0,0,0,0" />
            <input x="968" y="116" rotation="0" text="&lt;b&gt;Accanto al quadro&lt;/b&gt;&lt;br&gt;-X1 scatola da esterno, 3 prese Schuko: XS1 umidificatore 1, XS2 umidificatore 2, XS3 estrattore" font="Sans Serif,7,-1,5,50,0,0,0,0,0" />
            <input x="968" y="244" rotation="0" text="&lt;b&gt;Dentro la camera&lt;/b&gt;" font="Sans Serif,8,-1,5,50,0,0,0,0,0" />
            <input x="988" y="298" rotation="0" text="&lt;b&gt;-E1&lt;/b&gt; — stufa a 3 lampade IR (cavo -W1)" font="Sans Serif,7,-1,5,50,0,0,0,0,0" />
            <input x="988" y="354" rotation="0" text="&lt;b&gt;-B3&lt;/b&gt; — termostato di sicurezza a parete (cavo -W2)" font="Sans Serif,7,-1,5,50,0,0,0,0,0" />
            <input x="988" y="410" rotation="0" text="&lt;b&gt;-B1&lt;/b&gt; — sonda T/UR S-TH-01 (cavo -W3)" font="Sans Serif,7,-1,5,50,0,0,0,0,0" />
            <input x="988" y="466" rotation="0" text="&lt;b&gt;-A4 / -B2&lt;/b&gt; — HX711 in scatolina IP65 + cella di carico (cavo -W4)" font="Sans Serif,7,-1,5,50,0,0,0,0,0" />
            <input x="988" y="522" rotation="0" text="&lt;b&gt;-M2, -M3&lt;/b&gt; — umidificatori a ultrasuoni (prese XS1, XS2)" font="Sans Serif,7,-1,5,50,0,0,0,0,0" />
            <input x="988" y="578" rotation="0" text="&lt;b&gt;-M4&lt;/b&gt; — estrattore, lato opposto alle ventole (presa XS3)" font="Sans Serif,7,-1,5,50,0,0,0,0,0" />
            <input x="988" y="634" rotation="0" text="&lt;b&gt;-M5, -M6&lt;/b&gt; — ventole USB 5 V, lungo il muro" font="Sans Serif,7,-1,5,50,0,0,0,0,0" />
        </inputs>
