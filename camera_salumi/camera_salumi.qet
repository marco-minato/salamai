        <inputs>
            <input x="60" y="820" rotation="0" text="&lt;span style=&quot;color:#c00000&quot;&gt;&lt;b&gt;Rev. B — folio non ancora aggiornato:&lt;/b&gt; mancano sezionatore -Q0, interruttori -F1…-F3 e contattori -Q1…-Q7; il termostato -B3 passa sulla bobina di -Q7. Fa fede il folio 9.&lt;/span&gt;" font="Sans Serif,8,-1,5,50,0,0,0,0,0" />
            <input x="330" y="40" rotation="0" text="&lt;b&gt;Da quadro generale&lt;/b&gt;&lt;br&gt;linea già protetta: 16 A + Id 30 mA" font="Sans Serif,8,-1,5,50,0,0,0,0,0" />
            <input x="1256" y="274" rotation="0" text="L → COM K4, K5, K6" font="Sans Serif,7,-1,5,50,0,0,0,0,0" />
            <input x="1256" y="574" rotation="0" text="L-lampade → COM K1, K2, K3" font="Sans Serif,7,-1,5,50,0,0,0,0,0" />
            <input x="1066" y="614" rotation="0" text="N → stufa" font="Sans Serif,7,-1,5,50,0,0,0,0,0" />
            <input x="1066" y="574" rotation="0" text="N → prese" font="Sans Serif,7,-1,5,50,0,0,0,0,0" />
            <input x="1066" y="674" rotation="0" text="PE → stufa" font="Sans Serif,7,-1,5,50,0,0,0,0,0" />
            <input x="1066" y="714" rotation="0" text="PE → prese" font="Sans Serif,7,-1,5,50,0,0,0,0,0" />
            <input x="806" y="724" rotation="0" text="PE → Earth RS485 di -A1" font="Sans Serif,7,-1,5,50,0,0,0,0,0" />
            <input x="706" y="394" rotation="0" text="+12 V" font="Sans Serif,7,-1,5,50,0,0,0,0,0" />
            <input x="706" y="434" rotation="0" text="0 V" font="Sans Serif,7,-1,5,50,0,0,0,0,0" />
            <input x="1200" y="345" rotation="0" text="&lt;b&gt;In camera&lt;/b&gt;&lt;br&gt;termostato di sicurezza&lt;br&gt;a parete, tarato 28–30 °C&lt;br&gt;(cavo -W2)" font="Sans Serif,7,-1,5,50,0,0,0,0,0" />
            <input x="1180" y="500" rotation="0" text="TA apribile del PZEM attorno&lt;br&gt;al conduttore L-lampade" font="Sans Serif,7,-1,5,50,0,0,0,0,0" />
            <input x="640" y="50" rotation="0" text="&lt;b&gt;Note&lt;/b&gt;&lt;br&gt;• -B3 è in serie alle sole lampade ed è indipendente dal software.&lt;br&gt;• N e PE sono distribuiti a tutti gli utilizzatori con morsetti (-X2…).&lt;br&gt;• -A3: impostare l'indirizzo Modbus 2 (la sonda -B1 usa 1 o 42).&lt;br&gt;• -T1 è in classe II: non ha morsetto di terra." font="Sans Serif,8,-1,5,50,0,0,0,0,0" />
        </inputs>
        <shapes>
            <shape type="Rectangle" x1="1090" y1="340" x2="1300" y2="440" closed="0" is_movable="1" z="0" rx="0" ry="0">
