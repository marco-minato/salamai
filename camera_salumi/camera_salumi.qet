        <inputs>
            <input x="60" y="820" rotation="0" text="&lt;span style=&quot;color:#c00000&quot;&gt;&lt;b&gt;Rev. B — folio non ancora aggiornato:&lt;/b&gt; mancano sezionatore -Q0, interruttori -F1…-F3 e contattori -Q1…-Q7; il termostato -B3 passa sulla bobina di -Q7. Fa fede il folio 9.&lt;/span&gt;" font="Sans Serif,8,-1,5,50,0,0,0,0,0" />
            <input x="50" y="90" rotation="0" text="+12 V" font="Sans Serif,7,-1,5,50,0,0,0,0,0" />
            <input x="1286" y="94" rotation="0" text="+12 V → sonda -B1" font="Sans Serif,7,-1,5,50,0,0,0,0,0" />
            <input x="50" y="670" rotation="0" text="0 V" font="Sans Serif,7,-1,5,50,0,0,0,0,0" />
            <input x="1286" y="674" rotation="0" text="0 V → sonda -B1" font="Sans Serif,7,-1,5,50,0,0,0,0,0" />
            <input x="1050" y="360" rotation="0" text="ventole in parallelo (+ da -T2,&lt;br&gt;− verso OUT− del MOSFET)&lt;br&gt;tramite adattatori USB-A&lt;br&gt;femmina a morsetti" font="Sans Serif,7,-1,5,50,0,0,0,0,0" />
            <input x="1000" y="545" rotation="0" text="VIN+ e OUT+ di -A2:&lt;br&gt;non collegati (il + delle ventole&lt;br&gt;arriva direttamente da -T2)" font="Sans Serif,7,-1,5,50,0,0,0,0,0" />
            <input x="1040" y="180" rotation="0" text="&lt;b&gt;Note&lt;/b&gt;&lt;br&gt;• Masse 0 V di -T1, -T2, -A1 e -A2 in comune.&lt;br&gt;• PWM ventole: GPIO4, pin 15 del connettore H1;&lt;br&gt;&amp;nbsp;&amp;nbsp;massa del segnale su H1-13.&lt;br&gt;• -A2: comando low-side, ingresso logico 3,3 V.&lt;br&gt;• Selettore sul cavo delle ventole fisso su «alta»:&lt;br&gt;&amp;nbsp;&amp;nbsp;la velocità è regolata dal PWM." font="Sans Serif,8,-1,5,50,0,0,0,0,0" />
        </inputs>
    </diagram>
