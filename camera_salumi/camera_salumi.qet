            <input x="223" y="204" rotation="0" text="&lt;b&gt;-Q0&lt;/b&gt;&lt;br&gt;sez.&lt;br&gt;2P" font="Sans Serif,6,-1,5,50,0,0,0,0,0" />
            <input x="296" y="374" rotation="270" text="&lt;b&gt;-F1&lt;/b&gt; C10" font="Sans Serif,6,-1,5,50,0,0,0,0,0" />
            <input x="332" y="374" rotation="270" text="&lt;b&gt;-F2&lt;/b&gt; C6" font="Sans Serif,6,-1,5,50,0,0,0,0,0" />
            <input x="368" y="374" rotation="270" text="&lt;b&gt;-F3&lt;/b&gt; C6" font="Sans Serif,6,-1,5,50,0,0,0,0,0" />
            <input x="510" y="276" rotation="0" text="riserva" font="Sans Serif,6,-1,5,50,0,0,0,0,0" />
            <input x="683" y="204" rotation="0" text="&lt;b&gt;-T1&lt;/b&gt;&lt;br&gt;HDR-60-12&lt;br&gt;uscita 12 V&lt;br&gt;↑ in alto&lt;br&gt;&lt;br&gt;&lt;br&gt;&lt;br&gt;&lt;br&gt;&lt;br&gt;ingresso&lt;br&gt;230 V ↓" font="Sans Serif,6,-1,5,50,0,0,0,0,0" />
            <input x="222" y="644" rotation="270" text="&lt;b&gt;-Q7&lt;/b&gt; sicurezza" font="Sans Serif,6,-1,5,50,0,0,0,0,0" />
            <input x="266" y="644" rotation="270" text="&lt;b&gt;-Q1&lt;/b&gt;" font="Sans Serif,6,-1,5,50,0,0,0,0,0" />
            <input x="302" y="644" rotation="270" text="&lt;b&gt;-Q2&lt;/b&gt;" font="Sans Serif,6,-1,5,50,0,0,0,0,0" />
            <input x="338" y="644" rotation="270" text="&lt;b&gt;-Q3&lt;/b&gt;" font="Sans Serif,6,-1,5,50,0,0,0,0,0" />
            <input x="374" y="644" rotation="270" text="&lt;b&gt;-Q4&lt;/b&gt;" font="Sans Serif,6,-1,5,50,0,0,0,0,0" />
            <input x="410" y="644" rotation="270" text="&lt;b&gt;-Q5&lt;/b&gt;" font="Sans Serif,6,-1,5,50,0,0,0,0,0" />
            <input x="446" y="644" rotation="270" text="&lt;b&gt;-Q6&lt;/b&gt;" font="Sans Serif,6,-1,5,50,0,0,0,0,0" />
            <input x="510" y="546" rotation="0" text="riserva" font="Sans Serif,6,-1,5,50,0,0,0,0,0" />
            <input x="603" y="504" rotation="0" text="&lt;b&gt;-A3&lt;/b&gt; PZEM-016&lt;br&gt;&lt;br&gt;← L N TA" font="Sans Serif,6,-1,5,50,0,0,0,0,0" />
            <input x="726" y="584" rotation="0" text="RS485 →" font="Sans Serif,6,-1,5,50,0,0,0,0,0" />
            <input x="320" y="816" rotation="0" text="riserva" font="Sans Serif,6,-1,5,50,0,0,0,0,0" />
            <input x="493" y="744" rotation="0" text="↑ morsettiera relè: solo comandi bobine 12 V&lt;br&gt;&lt;br&gt;&lt;b&gt;-A1&lt;/b&gt; Waveshare ESP32-S3-Relay-6CH&lt;br&gt;145 × 90 × 40&lt;br&gt;&lt;br&gt;&lt;br&gt;&lt;br&gt;↓ alimentazione 12 V, RS485, H1" font="Sans Serif,6,-1,5,50,0,0,0,0,0" />
            <input x="223" y="1024" rotation="0" text="&lt;b&gt;-X0&lt;/b&gt; linea L N PE&lt;br&gt;&lt;b&gt;-X2&lt;/b&gt; uscite stufa, prese&lt;br&gt;&lt;b&gt;-XPE&lt;/b&gt; terra" font="Sans Serif,6,-1,5,50,0,0,0,0,0" />
            <input x="473" y="1024" rotation="0" text="&lt;b&gt;-T2&lt;/b&gt;&lt;br&gt;DC-DC" font="Sans Serif,6,-1,5,50,0,0,0,0,0" />
            <input x="547" y="1024" rotation="0" text="&lt;b&gt;-A2&lt;/b&gt;&lt;br&gt;MOSFET" font="Sans Serif,6,-1,5,50,0,0,0,0,0" />
            <input x="629" y="1024" rotation="0" text="&lt;b&gt;-X3&lt;/b&gt; SELV&lt;br&gt;sonda, HX711,&lt;br&gt;ventole,&lt;br&gt;termostato" font="Sans Serif,6,-1,5,50,0,0,0,0,0" />
            <input x="206" y="1304" rotation="0" text="linea" font="Sans Serif,6,-1,5,50,0,0,0,0,0" />
            <input x="286" y="1304" rotation="0" text="-W1" font="Sans Serif,6,-1,5,50,0,0,0,0,0" />
            <input x="366" y="1304" rotation="0" text="prese" font="Sans Serif,6,-1,5,50,0,0,0,0,0" />
            <input x="476" y="1304" rotation="0" text="-W3" font="Sans Serif,6,-1,5,50,0,0,0,0,0" />
            <input x="546" y="1304" rotation="0" text="-W4" font="Sans Serif,6,-1,5,50,0,0,0,0,0" />
            <input x="616" y="1304" rotation="0" text="M5" font="Sans Serif,6,-1,5,50,0,0,0,0,0" />
            <input x="686" y="1304" rotation="0" text="M6" font="Sans Serif,6,-1,5,50,0,0,0,0,0" />
            <input x="756" y="1304" rotation="0" text="-W2" font="Sans Serif,6,-1,5,50,0,0,0,0,0" />
            <input x="210" y="1332" rotation="0" text="pressacavi 230 V" font="Sans Serif,7,-1,5,50,0,0,0,0,0" />
            <input x="550" y="1332" rotation="0" text="pressacavi SELV" font="Sans Serif,7,-1,5,50,0,0,0,0,0" />
            <input x="960" y="100" rotation="0" text="&lt;b&gt;Zone e canaline&lt;/b&gt;&lt;table border=&quot;1&quot; cellspacing=&quot;0&quot; cellpadding=&quot;3&quot;&gt;&lt;tr&gt;&lt;th&gt;&lt;/th&gt;&lt;th&gt;Zona&lt;/th&gt;&lt;th&gt;Contenuto&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;span style=&quot;color:#ffb9a8&quot;&gt;■■&lt;/span&gt;&lt;/td&gt;&lt;td&gt;230 V&lt;/td&gt;&lt;td&gt;linea, protezioni, contatti dei contattori, uscite verso stufa e prese&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;span style=&quot;color:#a9c7ff&quot;&gt;■■&lt;/span&gt;&lt;/td&gt;&lt;td&gt;SELV&lt;/td&gt;&lt;td&gt;12 V, 5 V, 3,3 V, RS485, HX711, PWM, termostato -B3&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;&lt;span style=&quot;color:#e0c000&quot;&gt;■■&lt;/span&gt;&lt;/td&gt;&lt;td&gt;a cavallo&lt;/td&gt;&lt;td&gt;-T1 e -A3: isolamento interno tra i due lati (vedi criticità)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;▌&lt;/td&gt;&lt;td&gt;barriera&lt;/td&gt;&lt;td&gt;tappi di C1 e C2 verso CV2; setto tra -X2 e -T2 sulla guida D&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" font="Sans Serif,7,-1,5,50,0,0,0,0,0" />
            <input x="960" y="230" rotation="0" text="&lt;b&gt;Percorsi&lt;/b&gt;&lt;br&gt;• &lt;b&gt;230 V&lt;/b&gt;: linea e cavi di stufa e prese entrano in basso a sinistra, si attestano su -X0 / -X2 e salgono in CV1.&lt;br&gt;&amp;nbsp;&amp;nbsp;C0 alimenta -Q0 e -F1…-F3 dall'alto; C1 porta le uscite degli interruttori ai contattori, a -A3 e a -T1;&lt;br&gt;&amp;nbsp;&amp;nbsp;C2 raccoglie le uscite dei contattori e le riporta a -X2 passando da CV1.&lt;br&gt;• &lt;b&gt;Comandi bobine&lt;/b&gt; (12 V): dalla morsettiera relè di -A1 (bordo alto) salgono in C2 fino ad A1/A2 dei contattori.&lt;br&gt;&amp;nbsp;&amp;nbsp;Stanno nella canalina di potenza, quindi vanno fatti con filo isolato per 230 V (H05V-K / H07V-K).&lt;br&gt;• &lt;b&gt;SELV&lt;/b&gt;: dal bordo basso di -A1 (alimentazione, RS485, H1) in C3b e CV2; i cavi dei sensori entrano in basso a destra&lt;br&gt;&amp;nbsp;&amp;nbsp;e si attestano su -X3. L'uscita 12 V di -T1 e il lato RS485 di -A3 entrano direttamente in CV2.&lt;br&gt;• Nessun conduttore SELV in CV1, C0, C1; nessun conduttore 230 V in CV2, C3b. C1 e C2 sono tappate verso CV2.&lt;br&gt;&lt;br&gt;&lt;b&gt;Separazione per sicurezza&lt;/b&gt; (obbligatoria)&lt;br&gt;• Circuiti SELV e 230 V nella stessa canalina solo se &lt;i&gt;ogni&lt;/i&gt; conduttore è isolato per la tensione più alta&lt;br&gt;&amp;nbsp;&amp;nbsp;(regola CEI 64-8 art. 528.1): vale per i comandi bobine, non per i cavetti di sensori e RS485.&lt;br&gt;• Sulla scheda -A1 non arriva più il 230 V: i contatti dei relè di bordo commutano solo i 12 V delle bobine.&lt;br&gt;• Morsetti 230 V e SELV sulla guida D separati da fermi, setto e almeno 30 mm.&lt;br&gt;&lt;br&gt;&lt;b&gt;Separazione per i disturbi&lt;/b&gt; (consigliata)&lt;br&gt;• RS485 e cavo HX711 su doppini intrecciati, lontani da C2 e dai contattori; incroci a 90°.&lt;br&gt;• Andata e ritorno delle ventole (corrente PWM) intrecciati tra loro e non affiancati a DOUT / SCK dell'HX711.&lt;br&gt;• In CV2 tenere su un lato le alimentazioni e sull'altro i segnali; fili di segnale non più lunghi del necessario.&lt;br&gt;&lt;br&gt;&lt;b&gt;Ipotesi da confermare&lt;/b&gt;&lt;br&gt;• Dimensioni di cassetta e piastra; il centralino da 24 moduli (37 × 28 × 11,5 cm) non contiene questa disposizione.&lt;br&gt;• -T1: montaggio verticale con ingresso in basso e uscita in alto, 40 mm liberi sopra e 20 sotto (manuale Mean Well).&lt;br&gt;• -A3 non ha attacco DIN dichiarato: su clip o a vite sulla piastra, lato rete a sinistra.&lt;br&gt;• Connettore H1 di -A1 interno al contenitore: verificare da dove far uscire i fili (PWM, HX711).&lt;br&gt;• Piastra metallica: va collegata a -XPE. Pressacavi adatti al diametro di ogni cavo (M20 per i 230 V, M12 per i sensori)." font="Sans Serif,7,-1,5,50,0,0,0,0,0" />
        </inputs>
        <shapes>
            <shape type="Rectangle" x1="100" y1="70" x2="900" y2="1300" closed="0" is_movable="1" z="0" rx="0" ry="0">
                <pen style="SolidLine" widthF="2" color="#000000" />
                <brush style="NoBrush" color="#000000" />
            </shape>
            <shape type="Rectangle" x1="150" y1="120" x2="850" y2="1220" closed="0" is_movable="1" z="0" rx="0" ry="0">
                <pen style="SolidLine" widthF="1" color="#000000" />
