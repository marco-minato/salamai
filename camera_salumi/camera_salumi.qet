        <inputs>
            <input x="660" y="170" rotation="0" text="&lt;b&gt;Cassetta con piastra&lt;/b&gt; (in cantina) — disposizione fisica: folio 7" font="Sans Serif,8,-1,5,50,0,0,0,0,0" />
            <input x="62" y="170" rotation="0" text="&lt;span style=&quot;font-size:14pt&quot;&gt;&lt;b&gt;A&lt;/b&gt;&lt;/span&gt;" font="Sans Serif,9,-1,5,50,0,0,0,0,0" />
            <input x="62" y="440" rotation="0" text="&lt;span style=&quot;font-size:14pt&quot;&gt;&lt;b&gt;B&lt;/b&gt;&lt;/span&gt;" font="Sans Serif,9,-1,5,50,0,0,0,0,0" />
            <input x="62" y="720" rotation="0" text="&lt;span style=&quot;font-size:14pt&quot;&gt;&lt;b&gt;C&lt;/b&gt;&lt;/span&gt;" font="Sans Serif,9,-1,5,50,0,0,0,0,0" />
            <input x="62" y="1010" rotation="0" text="&lt;span style=&quot;font-size:14pt&quot;&gt;&lt;b&gt;D&lt;/b&gt;&lt;/span&gt;" font="Sans Serif,9,-1,5,50,0,0,0,0,0" />
            <input x="157" y="1140" rotation="0" text="linea" font="Sans Serif,7,-1,5,50,0,0,0,0,0" />
            <input x="284" y="1140" rotation="0" text="-W1" font="Sans Serif,7,-1,5,50,0,0,0,0,0" />
            <input x="414" y="1140" rotation="0" text="prese" font="Sans Serif,7,-1,5,50,0,0,0,0,0" />
            <input x="1169" y="1140" rotation="0" text="-W3" font="Sans Serif,7,-1,5,50,0,0,0,0,0" />
            <input x="1289" y="1140" rotation="0" text="-W4" font="Sans Serif,7,-1,5,50,0,0,0,0,0" />
            <input x="1409" y="1140" rotation="0" text="ventole" font="Sans Serif,7,-1,5,50,0,0,0,0,0" />
            <input x="1529" y="1140" rotation="0" text="-W2" font="Sans Serif,7,-1,5,50,0,0,0,0,0" />
            <input x="1100" y="390" rotation="0" text="+5V di -A3: uscita,&lt;br&gt;&lt;b&gt;non collegare&lt;/b&gt;" font="Sans Serif,6,-1,5,50,0,0,0,0,0" />
            <input x="1100" y="504" rotation="0" text="GND di -A3 → 0 V: solo dopo&lt;br&gt;la prova di isolamento" font="Sans Serif,6,-1,5,50,0,0,0,0,0" />
            <input x="298" y="374" rotation="0" text="L-lampade" font="Sans Serif,6,-1,5,50,0,0,0,0,0" />
            <input x="560" y="892" rotation="0" text="PE → piastra di fondo (se metallica)" font="Sans Serif,6,-1,5,50,0,0,0,0,0" />
            <input x="560" y="1200" rotation="0" text="&lt;b&gt;Vista d'insieme del cablaggio — rev. B&lt;/b&gt;&lt;br&gt;• Sulla scheda -A1 non arriva il 230 V: i relè di bordo K1…K6 commutano i 12 V delle bobine dei contattori -Q1…-Q6&lt;br&gt;&amp;nbsp;&amp;nbsp;(isolamento rinforzato bobina/contatti). -Q1…-Q3 lampade, -Q4…-Q5 umidificatori, -Q6 estrattore.&lt;br&gt;• Termostato di sicurezza -B3 sulla bobina di -Q7, a 12 V: -Q7 toglie la fase a tutte le lampade senza passare&lt;br&gt;&amp;nbsp;&amp;nbsp;dalla scheda e dal software. In camera non c'è più il 230 V sul termostato.&lt;br&gt;• Neutri separati per ramo: stufa da -F1, prese da -F2, ausiliari da -F3. Non unire i neutri a valle degli interruttori.&lt;br&gt;• -T1 è in classe II: nessun morsetto di terra. 0 V e PE non sono collegati tra loro.&lt;br&gt;• Morsetto G di -A1: ritorno degli scaricatori della RS485, non è la massa del bus.&lt;br&gt;• I punti neri sono ponticelli sulle morsettiere o derivazioni a pettine. Posizione dei morsetti sugli apparecchi indicativa.&lt;br&gt;• Non rappresentati: -A5 RTC opzionale (folio 6), interno della stufa (folio 3), NC dei relè, secondo polo dei contattori.&lt;br&gt;• Guide: A sezionamento, protezioni, alimentatore — B contattori e misura — C scheda di controllo (solo 12 V e segnali) — D morsettiere." font="Sans Serif,7,-1,5,50,0,0,0,0,0" />
        </inputs>
