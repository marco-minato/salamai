        <inputs>
            <input x="60" y="820" rotation="0" text="&lt;span style=&quot;color:#c00000&quot;&gt;&lt;b&gt;Rev. B — folio non ancora aggiornato:&lt;/b&gt; mancano sezionatore -Q0, interruttori -F1…-F3 e contattori -Q1…-Q7; il termostato -B3 passa sulla bobina di -Q7. Fa fede il folio 9.&lt;/span&gt;" font="Sans Serif,8,-1,5,50,0,0,0,0,0" />
            <input x="50" y="90" rotation="0" text="L" font="Sans Serif,7,-1,5,50,0,0,0,0,0" />
            <input x="50" y="270" rotation="0" text="N" font="Sans Serif,7,-1,5,50,0,0,0,0,0" />
            <input x="50" y="490" rotation="0" text="PE" font="Sans Serif,7,-1,5,50,0,0,0,0,0" />
            <input x="280" y="624" rotation="0" text="Umidificatore a ultrasuoni 1" font="Sans Serif,7,-1,5,50,0,0,0,0,0" />
            <input x="540" y="624" rotation="0" text="Umidificatore a ultrasuoni 2" font="Sans Serif,7,-1,5,50,0,0,0,0,0" />
            <input x="800" y="624" rotation="0" text="Estrattore" font="Sans Serif,7,-1,5,50,0,0,0,0,0" />
            <input x="900" y="170" rotation="0" text="&lt;b&gt;-A1&lt;/b&gt; Waveshare ESP32-S3-Relay-6CH&lt;br&gt;relè CH4, CH5, CH6&lt;br&gt;morsetti COM – NA (NC non usato)" font="Sans Serif,7,-1,5,50,0,0,0,0,0" />
            <input x="895" y="425" rotation="0" text="&lt;b&gt;-X1&lt;/b&gt; scatola da esterno&lt;br&gt;3 prese Schuko&lt;br&gt;(accanto al quadro)" font="Sans Serif,7,-1,5,50,0,0,0,0,0" />
            <input x="1040" y="280" rotation="0" text="&lt;b&gt;Note&lt;/b&gt;&lt;br&gt;• K5 e K6 sono su GPIO di strapping (45 / 46):&lt;br&gt;&amp;nbsp;&amp;nbsp;possibile breve scatto all'accensione, per questo&lt;br&gt;&amp;nbsp;&amp;nbsp;vi sono collegati carichi non critici.&lt;br&gt;• N e PE comuni alle tre prese.&lt;br&gt;• Umidificatori ridondanti (K4, K5); estrattore (K6)&lt;br&gt;&amp;nbsp;&amp;nbsp;sul lato opposto alle ventole." font="Sans Serif,8,-1,5,50,0,0,0,0,0" />
        </inputs>
