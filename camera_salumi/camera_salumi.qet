        <inputs>
            <input x="100" y="86" rotation="0" text="&lt;b&gt;Quadro IP65&lt;/b&gt; (in cantina)" font="Sans Serif,8,-1,5,50,0,0,0,0,0" />
            <input x="100" y="130" rotation="0" text="fila superiore:&lt;br&gt;230 V" font="Sans Serif,7,-1,5,50,0,0,0,0,0" />
