{
  "name": "salamai-room3d-viewer",
  "private": true,
  "version": "1.0.0",
  "description": "Visualizzatore web in sola lettura del modello 3D della camera Salamai",
  "type": "module",
  "scripts": {
    "sync-data": "node scripts/sync-data.mjs",
    "dev": "npm run sync-data && vite",
