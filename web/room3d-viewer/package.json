    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "check": "node scripts/check-readonly.mjs",
    "e2e": "node scripts/e2e.mjs"
  },
  "dependencies": {
    "three": "0.186.1"
  },
  "devDependencies": {
    "playwright-core": "1.64.0",
    "vite": "8.3.4"
  },
  "engines": {
    "node": ">=20"
  }
}
