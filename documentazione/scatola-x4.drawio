 height="18.0" as="geometry"/></mxCell><mxCell id="c72" value="M5 ventola" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=5.5;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="405.6" y="582.0" width="84.0" height="24.0" as="geometry"/></mxCell><mxCell id="c73" value="" style="ellipse;fillColor=#dae8fc;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="505.5" y="615.0" width="36.0" height="18.0" as="geometry"/></mxCell><mxCell id="c74" value="M6 ventola" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=5.5;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="481.5" y="582.0" width="84.0" height="24.0" as="geometry"/></mxCell><mxCell id="c75" value="" style="ellipse;fillColor=#dae8fc;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="581.4" y="615.0" width="36.0" height="18.0" as="geometry"/></mxCell><mxCell id="c76" value="M7 ventola" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=5.5;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="557.4" y="582.0" width="84.0" height="24.0" as="geometry"/></mxCell><mxCell id="c77" value="" style="ellipse;fillColor=#ffffff;strokeColor=#333333;dashed=1;" vertex="1" parent="1"><mxGeometry x="633.0" y="615.0" width="30.0" height="15.0" as="geometry"/></mxCell><mxCell id="c78" value="valvola anticondensa" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=5;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="612.0" y="582.0" width="66.0" height="24.0" as="geometry"/></mxCell><mxCell id="c79" value="" style="fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="420.0" y="174.0" width="252.0" height="120.0" as="geometry"/></mxCell><mxCell id="c80" value="&lt;b&gt;Come si legge&lt;/b&gt;&lt;br&gt;W5 verde → A2 PWM; bianco-verde → A2 GND (morsetti a vite, niente Wago).&lt;br&gt;A2 OUT− → Wago PWM: tira a massa il filo PWM delle 3 ventole.&lt;br&gt;Prolunghe ventole (fili neri, il n. 1 ha la riga): 1 GND → 0 V; 2 → +12 V; 3 giri → Wago giri; 4 → Wago PWM.&lt;br&gt;W5 bianco-arancio: di riserva, isolalo. Wago PWM: foro 5 libero." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=5.5;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="426.0" y="177.0" width="240.0" height="114.0" as="geometry"/></mxCell><mxCell id="c81" value="" style="endArrow=none;html=1;rounded=0;jumpStyle=arc;jumpSize=4;strokeColor=#6c8ebf;strokeWidth=9;opacity=55;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="117.6" y="618.0" as="sourcePoint"/><mxPoint x="117.6" y="534.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c82" value="" style="endArrow=none;html=1;rounded=0;jumpStyle=arc;jumpSize=4;strokeColor=#6c8ebf;strokeWidth=9;opacity=55;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="447.6" y="618.0" as="sourcePoint"/><mxPoint x="447.6" y="534.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c83" value="" style="endArrow=none;html=1;rounded=0;jumpStyle=arc;jumpSize=4;strokeColor=#6c8ebf;strokeWidth=9;opacity=55;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="523.5" y="618.0" as="sourcePoint"/><mxPoint x="523.5" y="534.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c84" value="" style="endArrow=none;html=1;rounded=0;jumpStyle=arc;jumpSize=4;strokeColor=#6c8ebf;strokeWidth=9;opacity=55;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="599.4" y="618.0" as="sourcePoint"/><mxPoint x="599.4" y="534.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c85" value="" style="endArrow=none;html=1;rounded=0;jumpStyle=arc;jumpSize=4;strokeColor=#2E7D32;strokeWidth=3;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="117.6" y="534.0" as="sourcePoint"/><mxPoint x="252.0" y="207.0" as="targetPoint"/><Array as="points"><mxPoint x="113.4" y="522.0"/><mxPoint x="113.4" y="355.5"/><mxPoint x="234.0" y="355.5"/><mxPoint