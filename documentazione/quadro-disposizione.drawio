le="text;html=1;align=left;verticalAlign=middle;fontSize=8;spacing=0;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1203.0" y="277.5" width="180.0" height="15.0" as="geometry"/></mxCell><mxCell id="c272" value="" style="fillColor=#999999;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1155.0" y="770.6" width="45.0" height="0.8" as="geometry"/></mxCell><mxCell id="c273" value="162" style="text;html=1;align=left;verticalAlign=middle;fontSize=8;spacing=0;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1203.0" y="763.5" width="180.0" height="15.0" as="geometry"/></mxCell><mxCell id="c274" value="" style="fillColor=#999999;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1155.0" y="1253.6" width="45.0" height="0.8" as="geometry"/></mxCell><mxCell id="c275" value="323" style="text;html=1;align=left;verticalAlign=middle;fontSize=8;spacing=0;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1203.0" y="1246.5" width="180.0" height="15.0" as="geometry"/></mxCell><mxCell id="c276" value="" style="fillColor=#999999;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1155.0" y="1739.6" width="45.0" height="0.8" as="geometry"/></mxCell><mxCell id="c277" value="485" style="text;html=1;align=left;verticalAlign=middle;fontSize=8;spacing=0;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1203.0" y="1732.5" width="180.0" height="15.0" as="geometry"/></mxCell><mxCell id="c278" value="" style="fillColor=#999999;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1155.0" y="359.6" width="45.0" height="0.8" as="geometry"/></mxCell><mxCell id="c279" value="25" style="text;html=1;align=left;verticalAlign=middle;fontSize=8;spacing=0;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1203.0" y="352.5" width="180.0" height="15.0" as="geometry"/></mxCell><mxCell id="c280" value="" style="fillColor=#999999;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1155.0" y="845.6" width="45.0" height="0.8" as="geometry"/></mxCell><mxCell id="c281" value="187" style="text;html=1;align=left;verticalAlign=middle;fontSize=8;spacing=0;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1203.0" y="838.5" width="180.0" height="15.0" as="geometry"/></mxCell><mxCell id="c282" value="" style="fillColor=#999999;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1155.0" y="1328.6" width="45.0" height="0.8" as="geometry"/></mxCell><mxCell id="c283" value="348" style="text;html=1;align=left;verticalAlign=middle;fontSize=8;spacing=0;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1203.0" y="1321.5" width="180.0" height="15.0" as="geometry"/></mxCell><mxCell id="c284" value="" style="fillColor=#999999;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1155.0" y="1814.6" width="45.0" height="0.8" as="geometry"/></mxCell><mxCell id="c285" value="510" style="text;html=1;align=left;verticalAlign=middle;fontSize=8;spacing=0;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1203.0" y="1807.5" width="180.0" height="15.0" as="geometry"/></mxCell><mxCell id="c286" value="" style="fillColor=#999999;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1155.0" y="1814.6" width="45.0" height="0.8" as="geometry"/></mxCell><mxCell id="c287" value="" style="fillColor=#c00000;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1155.0" y="565.1" width="45.0" height="0.8" as="geometry"/></mxCell><mxCell id="c288" value="asse guida 1: 93.5" style="text;html=1;align=left;verticalAlign=middle;fontSize=8;spacing=0;fontColor=#c00000;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1203.0" y="558.0" width="180.0" height="15.0" as="geometry"/></mxCell><mxCell id="c289" value="" style="fillColor=#c00000;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1155.0" y="1049.6" width="45.0" height="0.8" as="geometry"/></mxCell><mxCell id="c290" value="asse guida 2: 255" style="text;html=1;align=left;verticalAlign=middle;fontSize=8;spacing=0;fontColor=#c00000;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1203.0" y="1042.5" width="180.0" height="15.0" as="geometry"/></mxCell><mxCell id="c291" value="" style="fillColor=#c00000;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1155.0" y="1534.1" width="45.0" height="0.8" as="geometry"/></mxCell><mxCell id="c292" value="asse guida 3: 416.5" style="text;html=1;align=left;verticalAlign=middle;fontSize=8;spacing=0;fontColor=#c00000;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1203.0" y="1527.0" width="180.0" height="15.0" as="geometry"/></mxCell><mxCell id="c293" value="&lt;b&gt;Quote in mm&lt;/b&gt;&lt;br&gt;dal bordo alto piastra" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=7;" vertex="1" parent="1"><mxGeometry x="1185.0" y="237.0" width="192.0" height="42.0" as="geometry"/></mxCell><mxCell id="c294" value="canaline 25 mm&lt;br&gt;guide: centrare sull'asse rosso&lt;br&gt;&lt;br&gt;&lt;b&gt;In larghezza&lt;/b&gt; (dal bordo sinistro):&lt;br&gt;canalina sx 0–25&lt;br&gt;canalina dx 305–330&lt;br&gt;orizzontali lunghe 280&lt;br&gt;guide da 30 a 300 (270)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=7;" vertex="1" parent="1"><mxGeometry x="1185.0" y="1824.0" width="192.0" height="180.0" as="geometry"/></mxCell><mxCell id="c295" value="&lt;b&gt;Legenda&lt;/b&gt;&lt;br&gt;&lt;span style='background:#f8cecc'&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;/span&gt; 230 V · &lt;span style='background:#dae8fc'&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;/span&gt; bassa tensione 12 V · &lt;span style='background:#fff2cc'&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;/span&gt; contattori&lt;br&gt;&lt;span style='background:#97d077'&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;/span&gt; morsetti di terra (si serrano sulla guida) · &lt;span style='background:#7ea6e0'&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;/span&gt; neutro&lt;br&gt;X3: &lt;span style='background:#c3a6e8'&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;/span&gt; RS485 B · &lt;span style='background:#ffc98a'&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;/span&gt; RS485 A · &lt;span style='background:#4d4d4d'&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;/span&gt; 0 V · &lt;span style='background:#ea6b66'&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;/span&gt; +12 V (colori indicativi: i morsetti del kit sono grigi, usa i marcafili)&lt;br&gt;&lt;br&gt;&lt;b&gt;Note&lt;/b&gt;&lt;br&gt;• Scala: 1 mm = 3 px. Misure in mm.&lt;br&gt;• Vano interno 341×548×189 (dato venditore). Piastra 330 di larghezza (guide da 270 mm); &lt;b&gt;altezza 510 stimata&lt;/b&gt;: misurala, poi si ricalcolano le quote.&lt;br&gt;• 3 guide DIN da 270 mm tra le canaline laterali; 4 canaline orizzontali, fasce libere di ~137 mm.&lt;br&gt;• G1: T1 + Waveshare ≈ 200 mm · G2: Q1, contatore, 6 contattori ≈ 150 mm + X5 con F1, F2 ≈ 67 mm · G3: X2 ≈ 97 mm + X3 ≈ 97 mm.&lt;br&gt;• &lt;b&gt;G3 in acciaio&lt;/b&gt;: i morsetti di terra di X2 e X3 si serrano sulla guida.&lt;br&gt;• Niente morsettiera X0: le uscite di Q1 vanno ad alimentatore e contatore con puntalini doppi 2×1,5.&lt;br&gt;• Profondità interna 189 mm: verificare che la Waveshare con RTC e la sua antenna non tocchino sportello e coperchio della canalina.&lt;br&gt;• Fase ai contattori in catena sul morsetto 1 con puntalini doppi.&lt;br&gt;• Morsetti UK2.5B larghi 5,2 mm; 1 modulo = 17,5 mm.&lt;br&gt;• Ponticelli: X2 7-10 · X3 1-3, 4-6, 7-9, 10-12 · X5 2-3, 4-6 (X5 1 da solo).&lt;br&gt;• Fusibili 5×20 su portafusibili UK5-HESI: F1 → W3 camera (X5 2-3), F2 → W6 cantina (X5 1). F1 1 A T, F2 0,25 A T (ritardati)." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1470.0" y="150.0" width="720.0" height="990.0" as="geometry"/></mxCell><mxCell id="c296" value="&lt;b&gt;Fili&lt;/b&gt; (livelli «Fili 230 V» e «Fili bassa tensione»)&lt;br&gt;&lt;span style='color:#8B4513'&gt;━━&lt;/span&gt; fase L · &lt;span style='color:#1E56C8'&gt;━━&lt;/span&gt; neutro N · &lt;span style='color:#2E9B2E'&gt;╍╍&lt;/span&gt; terra&lt;br&gt;&lt;span style='color:#E00000'&gt;━━&lt;/span&gt; +12 V · &lt;span style='color:#000000'&gt;━━&lt;/span&gt; 0 V · &lt;span style='color:#E0399A'&gt;━━&lt;/span&gt; relè → + bobina contattore&lt;br&gt;&lt;span style='color:#FF8C00'&gt;━━&lt;/span&gt; RS485 A · &lt;span style='color:#8A2BE2'&gt;━━&lt;/span&gt; RS485 B&lt;br&gt;&lt;span style='color:#FF6A00'&gt;━●━●&lt;/span&gt; ponticello tra morsetti · &lt;span style='color:#999999'&gt;███&lt;/span&gt; cavi con guaina&lt;br&gt;Cat5e (W3, W6): colori veri dei conduttori (T568B); tratteggio = bianco-colore&lt;br&gt;&lt;br&gt;• X3 sopra: Waveshare, alimentatore, COM relè, contatore, 0 V verso X5, terra verso X2. X3 sotto: A e B dei Cat5e, ingressi di F1 e F2, ritorno bobine.&lt;br&gt;• X5 sopra: alimentazione dei Cat5e. X5 sotto: uscite di F1 e F2, 0 V da X3.&lt;br&gt;• Un solo filo per foro su X3. Puntalini doppi sulle uscite di Q1, sui COM dei relè e sui contattori (catene).&lt;br&gt;• Posizione dei morsetti su alimentatore, Waveshare e contatore indicativa." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=9;" vertex="1" parent="1"><mxGeometry x="1470.0" y="1170.0" width="720.0" height="600.0" as="geometry"/></mxCell><mxCell id="c182" value="" style="endArrow=none;html=1;rounded=0;jumpStyle=arc;jumpSize=6;strokeColor=#777777;strokeWidth=10;opacity=55;" edge="1" parent="L230"><mxGeometry relative="1" as="geometry"><mxPoint x="210.0" y="1950.0" as="sourcePoint"/><mxPoint x="210.0" y="1779.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c183" value="" style="endArrow=none;html=1;rounded=0;jumpStyle=arc;jumpSize=6;strokeColor=#8B4513;strokeWidth=2.4;" edge="1" parent="L230"><mxGeometry relative="1" as="geometry"><mxPoint x="210.0" y="1779.0" as="sourcePoint"/><mxPoint x="270.0" y="922.5" as="targetPoint"/><Array as="points"><mxPoint x="177.0" y="1770.0"/><mxPoint x="177.0" y="807.0"/><mxPoint x="270.0" y="807.0"/></Array></mxGeometry></mxCell><mxCell id="c184" value="" style="endArrow=none;html=1;rounded=0;jumpStyle=arc;jumpSize=6;strokeColor=#1E56C8;strokeWidth=2.4;" edge="1" parent="L230"><mxGeometry relative="1" as="geometry"><mxPoint x="210.0" y="1779.0" as="sourcePoint"/><mxPoint x="297.0" y="922.5" as="targetPoint"/><Array as="points"><mxPoint x="186.0" y="1774.5"/><mxPoint x="186.0" y="814.5"/><mxPoint x="297.0" y="814.5"/></Array></mxGeometry></mxCell><mxCell id="c185" value="" style="endArrow=none;html=1;rounded=0;jumpStyle=arc;jumpSize=6;strokeColor=#2E9B2E;strokeWidth=2.4;dashed=1;dashPattern=5 2;" edge="1" parent="L230"><mxGeometry relative="1" as="geometry"><mxPoint x="210.0" y="1779.0" as="sourcePoint"/><mxPoint x="524.7" y="1597.5" as="targetPoint"/><Array as="points"><mxPoint x="228.0" y="1795.5"/><mxPoint x="524.7" y="1795.5"/></Array></mxGeometry></mxCell><mxCell id="c186" value="" style="endArrow=none;html=1;rounded=0;jumpStyle=arc;jumpSize=6;strokeColor=#2E9B2E;strokeWidth=2.4;dashed=1;dashPattern=5 2;" edge="1" parent="L230"><mxGeometry relative="1" as="geometry"><mxPoint x="524.7" y="1471.5" as="sourcePoint"/><mxPoint x="544.2" y="1386.0" as="targetPoint"/><Array as="points"><mxPoint x="524.7" y="1386.0"/></Array></mxGeometry></mxCell><mxCell id="c189" value="" style="endArrow=none;html=1;rounded=0;jumpStyle=arc;jumpSize=6;strokeColor=#8B4513;strokeWidth=2.4;" edge="1" parent="L230"><mxGeometry relative="1" as="geometry"><mxPoint x="267.6" y="1177.5" as="sourcePoint"/><mxPoint x="288.0" y="700.5" as="targetPoint"/><Array as="points"><mxPoint x="267.6" y="1272.0"/><mxPoint x="195.0" y="1272.0"/><mxPoint x="195.0" y="786.0"/><mxPoint x="288.0" y="786.0"/></Array></mxGeometry></mxCell><mxCell id="c190" value="" style="endArrow=none;html=1;rounded=0;jumpStyle=arc;jumpSize=6;strokeColor=#1E56C8;strokeWidth=2.4;" edge="1" parent="L230"><mxGeometry relative="1" as="geometry"><mxPoint x="294.6" y="1177.5" as="sourcePoint"/><mxPoint x="318.0" y="700.5" as="targetPoint"/><Array