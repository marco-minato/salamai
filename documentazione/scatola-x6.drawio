t="1"><mxGeometry x="432.0" y="315.0" width="72.0" height="12.0" as="geometry"/></mxCell><mxCell id="c181" value="C3 · 4 fili" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=6;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="394.5" y="336.0" width="72.0" height="12.0" as="geometry"/></mxCell><mxCell id="c182" value="" style="fillColor=none;strokeColor=#ff9800;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="333.3" y="275.4" width="32.5" height="13.2" as="geometry"/></mxCell><mxCell id="c183" value="" style="fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="600.0" y="180.0" width="498.0" height="111.0" as="geometry"/></mxCell><mxCell id="c184" value="&lt;b&gt;Cavetti · apertura ai due estremi del tratto spesso&lt;/b&gt;&lt;br&gt;C1: femmina sui 4 pin HX711. GND → Wago GND f.2; VCC → 3,3 V f.2; DT → D1; SCK → D3.&lt;br&gt;C2: 1 GND → GND f.1; 2 3V3 → 3,3 V f.1; 3 D10 → 1-Wire f.1.&lt;br&gt;C3: 1 D0 → giri M5 f.1; 2 D8 → giri M6 f.1; 3 D7 → W5 verde (modulo MOSFET in X4); 4 D6 → giri M7 f.1.&lt;br&gt;C2: filo 4 isolato a entrambi i capi. Tutti neri; n.1 con riga.&lt;br&gt;Guscio sinistro D0–D5: C3·1 / C1·DT / vuoto / C1·SCK / vuoto / vuoto.&lt;br&gt;Guscio destro GND–D7: C2·1 / C2·2 / C2·3 / vuoto / C3·2 / C3·3.&lt;br&gt;D6: guscio da 1, C3·4. Ordine dal lato USB. Tappo vuoto: 5V. Colori = funzione del filo." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=6;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="606.0" y="183.0" width="486.0" height="105.0" as="geometry"/></mxCell><mxCell id="c185" value="" style="endArrow=none;html=1;rounded=0;jumpStyle=arc;jumpSize=4;strokeColor=#424242;strokeWidth=7;opacity=100;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="273.0" y="348.0" as="sourcePoint"/><mxPoint x="588.0" y="348.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c186" value="" style="endArrow=none;html=1;rounded=0;jumpStyle=arc;jumpSi